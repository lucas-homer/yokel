# Copy to .env (gitignored) and fill in. Nothing auto-loads .env — pass it explicitly:
#   DATABASE_URL=... pnpm --filter @yokel/docketclock test
# The Regs.gov smoke self-loads this file via process.loadEnvFile.

# Postgres connection string for the observation log (local throwaway or CNPG-managed in-cluster).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/docketclock

# Regulations.gov v4 API key (api.regulations.gov / api.data.gov). Registered key = 1,000 req/hr;
# DEMO_KEY is ~30/hr. Used by the Regs.gov adapter's keyed fetch and `pnpm smoke:regs`.
REGS_API_KEY=

# Optional: override the Regs.gov v4 base (defaults to https://api.regulations.gov/v4).
# REGS_API_BASE=https://api.regulations.gov/v4

# LLM adjudicator for the chain-seam escalation. Every LLM call goes through Cloudflare AI Gateway; the live
# model is ADJUDICATOR_MODEL in apps/docketclock/src/adjudicator/model.ts. Without BOTH of these the poller is
# deterministic-only (null:abstain, safe). The token needs Account > Workers AI > Read.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_AI_TOKEN=
# Optional: ADJUDICATOR=off disables it; ADJUDICATOR=<catalog id> (e.g. openai/gpt-5.4-mini) tries another
# model locally. Compare candidates with `pnpm --filter @yokel/docketclock eval:models --models a,b,c`.
# ADJUDICATOR=
# CLOUDFLARE_AI_GATEWAY=default
# LLM_TIMEOUT_MS=15000

# Langfuse LLM-observability tracing for the chain-seam adjudicator (Slice C, PR-C2). OPT-IN and
# ALL-OR-NOTHING: tracing activates only when ALL THREE of LANGFUSE_HOST / LANGFUSE_PUBLIC_KEY /
# LANGFUSE_SECRET_KEY are set; with any unset a NoopTracer is injected (no langfuse client constructed) and
# the adjudication path is byte-for-byte unchanged. Independent of ADJUDICATOR — but only the gemini adapter
# makes real LLM calls, so traces only appear with ADJUDICATOR=gemini. The Gemini API key + the secret key
# below NEVER enter a trace (only public Federal Register notice text + derived metadata do).
# In-cluster the host is the langfuse Service; the public/secret keys are minted per-project in the
# Langfuse UI (dev values shown). See plans/observability-llm.md.
# LANGFUSE_HOST=http://langfuse.langfuse.svc:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-dev-docketclock
# LANGFUSE_SECRET_KEY=sk-lf-dev-docketclock
