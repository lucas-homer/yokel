{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "synthetic": {
      "type": "boolean"
    },
    "state": {
      "enum": [
        "WA",
        "CT",
        "VA",
        "MA",
        "TN",
        "MS"
      ]
    },
    "universe_version": {
      "type": "string",
      "minLength": 1
    },
    "scope_resolved": {
      "type": "boolean"
    },
    "history_bounded": {
      "type": "boolean"
    },
    "attended": {
      "type": "boolean"
    },
    "rights_file": {
      "type": "string",
      "minLength": 1
    },
    "processes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "agency_id": {
            "type": "string",
            "minLength": 1
          },
          "process_id": {
            "type": "string",
            "minLength": 1
          },
          "single_lineage": {
            "type": "boolean"
          },
          "human_review_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "coverage": {
            "type": "object",
            "properties": {
              "mode": {
                "enum": [
                  "independent_full",
                  "independent_partial",
                  "single_lineage"
                ]
              },
              "unit_kind": {
                "enum": [
                  "agency_process",
                  "proceeding"
                ]
              },
              "universe_basis": {
                "type": "string",
                "minLength": 1
              },
              "universe": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "unit_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "agency_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "unit_id",
                    "agency_id"
                  ],
                  "additionalProperties": false
                }
              },
              "checks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "entry_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "against_entry_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "scope": {
                      "enum": [
                        "full",
                        "partial"
                      ]
                    },
                    "scope_basis": {
                      "type": "string",
                      "minLength": 1
                    },
                    "expected_unit_ids": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "matched_unit_ids": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "mismatched_unit_ids": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "unresolved_unit_ids": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": [
                    "entry_id",
                    "against_entry_id",
                    "scope",
                    "scope_basis",
                    "expected_unit_ids",
                    "matched_unit_ids",
                    "mismatched_unit_ids",
                    "unresolved_unit_ids"
                  ],
                  "additionalProperties": false
                }
              },
              "claim_agency_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "completeness": {
                "enum": [
                  "established",
                  "not_established"
                ]
              }
            },
            "required": [
              "mode",
              "unit_kind",
              "universe_basis",
              "universe",
              "checks",
              "claim_agency_ids",
              "completeness"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "agency_id",
          "process_id",
          "single_lineage",
          "human_review_ref"
        ],
        "additionalProperties": false
      }
    },
    "brief_file": {
      "type": "string",
      "minLength": 1
    },
    "brief_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "brief_frozen_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "passes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pass": {
            "enum": [
              "pass_A",
              "pass_B"
            ]
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "brief_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "dispatched_at": {
            "type": "string",
            "format": "date-time"
          },
          "sealed_at": {
            "type": "string",
            "format": "date-time"
          },
          "output_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "isolated": {
            "const": true
          }
        },
        "required": [
          "pass",
          "provider",
          "model",
          "task_id",
          "brief_sha256",
          "dispatched_at",
          "sealed_at",
          "output_sha256",
          "isolated"
        ],
        "additionalProperties": false
      }
    },
    "crosswalk": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "canonical_entity_id": {
            "type": "string",
            "minLength": 1
          },
          "identity_action": {
            "enum": [
              "same",
              "merge",
              "split"
            ]
          },
          "adjudication_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "record_id",
          "canonical_entity_id",
          "identity_action",
          "adjudication_ref"
        ],
        "additionalProperties": false
      }
    },
    "completeness_review_ref": {
      "type": "string",
      "minLength": 1
    },
    "mandatory_review_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "temporal_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "ambiguity": {
            "type": "string",
            "minLength": 1
          },
          "human_review_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "policy_question": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "record_id",
          "field",
          "ambiguity",
          "human_review_ref",
          "policy_question"
        ],
        "additionalProperties": false
      }
    },
    "audit": {
      "type": "object",
      "properties": {
        "seed": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "frame_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "coarsening_level": {
          "enum": [
            0,
            1,
            2,
            3
          ]
        },
        "frozen_before_seed": {
          "type": "boolean"
        },
        "mandatory_minutes_estimate": {
          "type": "number",
          "minimum": 0
        },
        "overlap_minutes": {
          "type": "number",
          "minimum": 0
        },
        "estimate_minutes": {
          "type": "number",
          "minimum": 0
        },
        "actual_minutes": {
          "type": "number",
          "minimum": 0
        },
        "strata": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stratum_id": {
                "type": "string",
                "minLength": 1
              },
              "unit_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "disposition": {
                "enum": [
                  "inclusion",
                  "exclusions_only",
                  "no_candidates"
                ]
              },
              "high_risk": {
                "type": "boolean"
              },
              "minutes_per_unit": {
                "type": "number",
                "minimum": 0
              },
              "sample_size": {
                "type": "integer",
                "minimum": 0
              },
              "selected_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "completed_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "stratum_id",
              "unit_ids",
              "disposition",
              "high_risk",
              "minutes_per_unit",
              "sample_size",
              "selected_ids",
              "completed_ids"
            ],
            "additionalProperties": false
          }
        },
        "unit_coverage": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "coarsening_history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "level": {
                "enum": [
                  1,
                  2,
                  3
                ]
              },
              "estimate_minutes": {
                "type": "number",
                "minimum": 0
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "level",
              "estimate_minutes",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "seed",
        "frame_hash",
        "coarsening_level",
        "frozen_before_seed",
        "mandatory_minutes_estimate",
        "overlap_minutes",
        "estimate_minutes",
        "actual_minutes",
        "strata",
        "unit_coverage",
        "coarsening_history"
      ],
      "additionalProperties": false
    },
    "credits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "state": {
            "enum": [
              "WA",
              "CT",
              "VA",
              "TN",
              "MS"
            ]
          },
          "actual": {
            "type": "integer",
            "minimum": 0
          },
          "outstanding": {
            "type": "integer",
            "minimum": 0
          },
          "reserve_released": {
            "type": "integer",
            "minimum": 0
          },
          "primary_release_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "reviewer_minutes": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "state",
          "actual",
          "outstanding",
          "reserve_released",
          "primary_release_ref",
          "reviewer_minutes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "synthetic",
    "state",
    "universe_version",
    "scope_resolved",
    "history_bounded",
    "attended",
    "rights_file",
    "processes",
    "brief_file",
    "brief_sha256",
    "brief_frozen_at",
    "passes",
    "crosswalk",
    "completeness_review_ref",
    "mandatory_review_refs",
    "temporal_log",
    "audit",
    "credits"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
