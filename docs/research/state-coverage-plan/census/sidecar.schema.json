{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "byte_length": {
      "type": "integer",
      "minimum": 0
    },
    "captures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "manifest_entry_id": {
            "type": "string",
            "minLength": 1
          },
          "requested_url": {
            "type": "string",
            "minLength": 1
          },
          "final_url": {
            "type": "string",
            "minLength": 1
          },
          "capture_method": {
            "type": "string",
            "minLength": 1
          },
          "response_headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "captured_at": {
            "type": "string",
            "format": "date-time"
          },
          "rights_surface_id": {
            "type": "string",
            "minLength": 1
          },
          "rights_version": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "manifest_entry_id",
          "requested_url",
          "final_url",
          "capture_method",
          "response_headers",
          "captured_at",
          "rights_surface_id",
          "rights_version"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "sha256",
    "byte_length",
    "captures"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
