{
  "type": "object",
  "properties": {
    "surface_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "WA",
        "CT",
        "VA",
        "MA",
        "TN"
      ]
    },
    "url_pattern": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "collection_rule": {
      "enum": [
        "allowed",
        "allowed_watched_only",
        "on_hold",
        "blocked"
      ]
    },
    "retention": {
      "enum": [
        "internal_originals",
        "not_authorized"
      ]
    },
    "third_party_processing": {
      "enum": [
        "public_notices_only",
        "not_authorized"
      ]
    },
    "public_evidence_rule": {
      "type": "string",
      "minLength": 1
    },
    "rate": {
      "type": "object",
      "properties": {
        "min_interval_seconds": {
          "type": "number",
          "minimum": 5
        },
        "concurrency": {
          "const": 1
        },
        "stop_on_status": {
          "const": [
            403,
            429
          ]
        },
        "identifying_user_agent": {
          "const": true
        },
        "no_bot_workaround": {
          "const": true
        }
      },
      "required": [
        "min_interval_seconds",
        "concurrency",
        "stop_on_status",
        "identifying_user_agent",
        "no_bot_workaround"
      ],
      "additionalProperties": false
    },
    "decision_ref": {
      "type": "string",
      "minLength": 1
    },
    "decision_version": {
      "type": "string",
      "minLength": 1
    },
    "decision_date": {
      "type": "string",
      "format": "date"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "open_outreach_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "surface_id",
    "state",
    "url_pattern",
    "version",
    "collection_rule",
    "retention",
    "third_party_processing",
    "public_evidence_rule",
    "rate",
    "decision_ref",
    "decision_version",
    "decision_date",
    "evidence_refs",
    "open_outreach_ref",
    "notes"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
