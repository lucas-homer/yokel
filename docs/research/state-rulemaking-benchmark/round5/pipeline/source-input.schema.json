{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "documents"],
  "properties": {
    "schema_version": {"const": "round4.sources.v1"},
    "documents": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["document_id", "channel", "text_path", "text_sha256", "pdf_path", "pdf_sha256", "pdf_pages", "scope", "native_page_map_known"],
      "properties": {
        "document_id": {"type": "string", "pattern": "^doc-[a-f0-9]{12}$"},
        "channel": {"enum": ["native", "fallback"]},
        "text_path": {"type": "string", "minLength": 1},
        "text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "pdf_path": {"type": "string", "minLength": 1},
        "pdf_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "pdf_pages": {"type": "integer", "minimum": 1},
        "scope": {"enum": ["full_notice", "slice", "unknown"]},
        "native_page_map_known": {"type": "boolean"}
      }
    }}
  }
}
