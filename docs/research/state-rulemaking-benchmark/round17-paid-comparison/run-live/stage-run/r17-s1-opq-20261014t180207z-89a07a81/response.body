"q\":0,\"r\":\"\",\"u\":51,\"w\":\"if\",\"x\":[]},{\"n\":\"c11\",\"q\":0,\"r\":\"\",\"u\":51,\"w\":\"if\",\"x\":[]},{\"n\":\"c10\",\"q\":0,\"r\":\"\",\"u\":52,\"w\":\"if\",\"x\":[]},{\"n\":\"c12\",\"q\":2,\"r\":\"Definition remains unresolved; prohibition is explicit.\",\"u\":52,\"w\":\"obj\",\"x\":[]}],\"t\":\"895dd2d935aa6f618195f063afd780900cef7a1bb8a6d96f5f434b6f8c2475dd\",\"u\":[{\"b\":[],\"d\":[],\"e\":[\"s1\"],\"i\":1,\"k\":0,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"Notice identifier is WSR 26-19-039.\",\"y\":[]},{\"b\":[],\"d\":[1],\"e\":[\"s3\",\"s5\"],\"i\":2,\"k\":0,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"State Board of Health issues this proposed-rules notice.\",\"y\":[]},{\"b\":[],\"d\":[1],\"e\":[\"s7\"],\"i\":3,\"k\":3,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"Notice was filed September 10, 2026.\",\"y\":[]},{\"b\":[],\"d\":[3],\"e\":[\"s7\"],\"i\":4,\"k\":3,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"Filing time was 5:09 p.m.; timezone is not stated.\",\"y\":[]},{\"b\":[],\"d\":[1],\"e\":[\"s9\"],\"i\":5,\"k\":0,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"This is an Original Notice.\",\"y\":[]},{\"b\":[],\"d\":[1],\"e\":[\"s11\"],\"i\":6,\"k\":8,\"m\":0,\"p\":1,\"q\":0,\"r\":\"\",\"s\":\"Proposal reports exemption under RCW 34.05.310(4) or 34.05.330(1).\",\"y\":[]},{\"b\":[],\"d\":[],\"e\":[\"s13\"],\"i\":7,\"k\":0,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"Affected chapter is chapter 246-203 WAC; proposal title is Pet dogs in domestic breweries and microbreweries.\",\"y\":[]},{\"b\":[],\"d\":[7],\"e\":[\"s13\",\"s21\"],\"i\":8,\"k\":1,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"Proposal amends chapter 246-203 WAC, General sanitation, to add a new section/subsection allowing pet dogs in domestic breweries and microbreweries.\",\"y\":[]},{\"b\":[],\"d\":[1],\"e\":[\"s15\"],\"i\":9,\"k\":2,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"A hearing is scheduled with in-person or virtual attendance alternatives.\",\"y\":[]},{\"b\":[],\"d\":[9],\"e\":[\"s15\"],\"i\":10,\"k\":3,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"Hearing date is November 18, 2026.\",\"y\":[]},{\"b\":[],\"d\":[9],\"e\":[\"s15\"],\"i\":11,\"k\":3,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"Hearing time is 1:30 [p.m.]; timezone is not stated.\",\"y\":[]},{\"b\":[],\"d\":[9],\"e\":[\"s15\"],\"i\":12,\"k\":4,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"Physical endpoint: Snohomish County Health Department, 3020 Rucker Avenue, Everett, WA 98201, First-floor auditorium.\",\"y\":[]},{\"b\":[],\"d\":[12,9],\"e\":[\"s15\"],\"i\":13,\"k\":5,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"Physical endpoint serves as the in-person hearing location.\",\"y\":[]},{\"b\":[],\"d\":[9],\"e\":[\"s15\"],\"i\":14,\"k\":4,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"Virtual endpoint: https://us02web.zoom.us/webinar/register/WN_m0uliPy0Q_yQgZZHZdbKXA.\",\"y\":[]},{\"b\":[],\"d\":[14,9],\"e\":[\"s15\"],\"i\":15,\"k\":5,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"Virtual endpoint serves as the Zoom webinar hearing alternative.\",\"y\":[]},{\"b\":[],\"d\":[14],\"e\":[\"s15\"],\"i\":16,\"k\":8,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"Zoom webinar ID is 817 0952 3832; passcode is 682856.\",\"y\":[]},{\"b\":[],\"d\":[8],\"e\":[\"s17\"],\"i\":17,\"k\":3,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"Intended adoption date is November 18, 2026.\",\"y\":[]},{\"b\":[],\"d\":[1],\"e\":[\"s19\"],\"i\":18,\"k\":6,\"m\":5,\"p\":0,\"q\":1,\"r\":\"Submission invitation gives directions but does not establish mandatory participation.\",\"s\":\"Written comments are directed to Ash Noble; purpose is comment submission.\",\"y\":[]},{\"b\":[],\"d\":[],\"e\":[\"s19\"],\"i\":19,\"k\":4,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"Postal endpoint: P.O. Box 47990, Olympia, WA 98504-7990.\",\"y\":[]},{\"b\":[],\"d\":[19,18],\"e\":[\"s19\"],\"i\":20,\"k\":5,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"Postal endpoint is supplied for written comments to Ash Noble.\",\"y\":[]},{\"b\":[],\"d\":[],\"e\":[\"s19\"],\"i\":21,\"k\":4,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"Email endpoint: ash.noble@sboh.wa.gov.\",\"y\":[]},{\"b\":[],\"d\":[21,18],\"e\":[\"s19\"],\"i\":22,\"k\":5,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"Email endpoint is supplied for written comments to Ash Noble.\",\"y\":[]},{\"b\":[],\"d\":[8],\"e\":[\"s21\"],\"i\":23,\"k\":8,\"m\":1,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"RCW 66.24.240(7) and 66.24.244(8) require the board to adopt dog-presence rules; proposal's purpose is compliance.\",\"y\":[]},{\"b\":[],\"d\":[18],\"e\":[\"s19\"],\"i\":24,\"k\":3,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"Written-comment submission period begins September 28, 2026.\",\"y\":[]},{\"b\":[],\"d\":[23],\"e\":[\"s23\"],\"i\":25,\"k\":8,\"m\":1,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"Supporting reasons quote RCW 66.24.240(7) and 66.24.244(8) as requiring the board to adopt rules allowing dogs.\",\"y\":[]},{\"b\":[],\"d\":[],\"e\":[\"s23\"],\"i\":26,\"k\":8,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"The 2025 legislature passed EHB 1602, chapter 141, Laws of 2025, amending multiple statutes to allow domestic breweries and microbreweries to provide food service via contract kitchens.\",\"y\":[]},{\"b\":[],\"d\":[26],\"e\":[\"s23\"],\"i\":27,\"k\":8,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"A contract kitchen may be a mobile food service, such as a food truck, or another independently operated food-service provider.\",\"y\":[]},{\"b\":[],\"d\":[26],\"e\":[\"s23\"],\"i\":28,\"k\":8,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"EHB 1602 was codified as RCW 66.24.240, 66.24.244, 66.24.320, 66.24.410, 66.04.010, and 66.24.400.\",\"y\":[]},{\"b\":[],\"d\":[26],\"e\":[\"s23\"],\"i\":29,\"k\":3,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"EHB 1602 became effective July 27, 2025.\",\"y\":[]},{\"b\":[],\"d\":[8,26],\"e\":[\"s25\"],\"i\":30,\"k\":1,\"m\":1,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"Amendments require changes to board rules in chapter 246-203 WAC allowing qualifying domestic breweries or microbreweries to allow pet dogs on site.\",\"y\":[]},{\"b\":[],\"d\":[8],\"e\":[\"s27\"],\"i\":31,\"k\":8,\"m\":1,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"RCW 66.24.240 and 66.24.244 are adoption authority requiring board rules regarding dogs in qualifying breweries and microbreweries.\",\"y\":[]},{\"b\":[],\"d\":[31],\"e\":[\"s29\"],\"i\":32,\"k\":8,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"Authorizing statutes and statutes being implemented are the same.\",\"y\":[]},{\"b\":[],\"d\":[8],\"e\":[\"s31\"],\"i\":33,\"k\":8,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"Rule is not necessitated by federal law or a federal or state court decision.\",\"y\":[]},{\"b\":[],\"d\":[1],\"e\":[\"s33\"],\"i\":34,\"k\":0,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"Proponent is the Washington state legislature, governmental.\",\"y\":[]},{\"b\":[],\"d\":[19],\"e\":[\"s35\"],\"i\":35,\"k\":5,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"Postal endpoint is also supplied for Ash Noble as personnel responsible for drafting.\",\"y\":[]},{\"b\":[],\"d\":[7],\"e\":[\"s35\"],\"i\":36,\"k\":8,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"Local boards of health implement and enforce the state board of health's general sanitation rules, chapter 246-203 WAC.\",\"y\":[]},{\"b\":[],\"d\":[8],\"e\":[\"s35\"],\"i\":37,\"k\":8,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"No penalties are associated with this rule making; it is permissive and not mandatory.\",\"y\":[]},{\"b\":[],\"d\":[8],\"e\":[\"s37\"],\"i\":38,\"k\":8,\"m\":0,\"p\":2,\"q\":2,\"r\":\"Cited statutory basis is not supplied.\",\"s\":\"A school district fiscal impact statement is not required under RCW 28A.305.135.\",\"y\":[]},{\"b\":[],\"d\":[8],\"e\":[\"s39\"],\"i\":39,\"k\":8,\"m\":0,\"p\":1,\"q\":0,\"r\":\"\",\"s\":\"A cost-benefit analysis is not required under RCW 34.05.328.\",\"y\":[]},{\"b\":[],\"d\":[8],\"e\":[\"s39\"],\"i\":40,\"k\":8,\"m\":0,\"p\":1,\"q\":0,\"r\":\"\",\"s\":\"Rule is exempt from RCW 34.05.328 requirements, including a cost-benefit analysis, because its content is explicitly and specifically dictated by statute.\",\"y\":[]},{\"b\":[],\"d\":[8],\"e\":[\"s41\",\"s43\"],\"i\":41,\"k\":8,\"m\":0,\"p\":1,\"q\":0,\"r\":\"\",\"s\":\"Proposal or portions are exempt from Regulatory Fairness Act requirements under RCW 19.85.025(3), because content is explicitly and specifically dictated by statute.\",\"y\":[]},{\"b\":[],\"d\":[41],\"e\":[\"s45\"],\"i\":42,\"k\":8,\"m\":1,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"Exemption explanation identifies RCW 66.24.240(7)'s dog-rule mandate and RCW 66.24.244(8)'s same mandate for microbreweries; rule provisions are stated in the authorizing statute.\",\"y\":[]},{\"b\":[],\"d\":[41],\"e\":[\"s47\",\"s49\"],\"i\":43,\"k\":8,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"Stated scope of exemption for the rule proposal is fully exempt.\",\"y\":[]},{\"b\":[],\"d\":[1],\"e\":[\"s51\"],\"i\":44,\"k\":3,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"Notice signature block is dated September 10, 2026.\",\"y\":[]},{\"b\":[],\"d\":[44],\"e\":[\"s53\",\"s55\"],\"i\":45,\"k\":0,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"Signature block names Michelle A. Davis, Executive Director.\",\"y\":[]},{\"b\":[],\"d\":[8],\"e\":[\"s57\"],\"i\":46,\"k\":0,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"Draft identifier is RDS-7373.1.\",\"y\":[]},{\"b\":[],\"d\":[7],\"e\":[\"s61\"],\"i\":47,\"k\":0,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"Affected section is WAC 246-203-015, Dogs in breweries and micro breweries that are not licensed food service establishments.\",\"y\":[]},{\"b\":[],\"d\":[47,8],\"e\":[\"s59\",\"s61\"],\"i\":48,\"k\":1,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"Proposed text designates WAC 246-203-015 as a NEW SECTION.\",\"y\":[]},{\"b\":[],\"d\":[18],\"e\":[\"s19\"],\"i\":49,\"k\":3,\"m\":0,\"p\":0,\"q\":1,\"r\":\"Deadline timezone and receipt-versus-dispatch basis are not stated.\",\"s\":\"Written comments are due by 11:59 p.m., October 23, 2026.\",\"y\":[{\"b\":{\"r\":\"\",\"s\":\"absent\",\"x\":[]},\"c\":{\"r\":\"\",\"s\":\"stated\",\"x\":[{\"a\":\"s19\",\"h\":\"11:59 p.m.\",\"ho\":1,\"t\":\"11:59 p.m.\",\"to\":1,\"z\":\"s19\"}]},\"z\":{\"r\":\"\",\"s\":\"absent\",\"x\":[]}}]},{\"b\":[],\"d\":[47,48],\"e\":[\"s64\"],\"i\":50,\"k\":8,\"m\":0,\"p\":1,\"q\":0,\"r\":\"\",\"s\":\"Proposed section applies to the domestic breweries and microbreweries specified in subsection (1), with its licensing and food-service qualifications.\",\"y\":[]},{\"b\":[],\"d\":[47,48],\"e\":[\"s66\"],\"i\":51,\"k\":6,\"m\":3,\"p\":1,\"q\":0,\"r\":\"\",\"s\":\"Under proposed subsection (2), a qualifying domestic brewery or microbrewery may choose to allow pet dogs on the premises.\",\"y\":[]},{\"b\":[],\"d\":[47,48],\"e\":[\"s68\"],\"i\":52,\"k\":6,\"m\":4,\"p\":1,\"q\":2,\"r\":\"RCW 49.60.040 service-animal definition is referenced but not supplied.\",\"s\":\"Under proposed subsection (3), a domestic brewery or microbrewery may not prohibit a patron from bringing a service animal on the premises.\",\"y\":[]},{\"b\":[],\"d\":[],\"e\":[\"s35\"],\"i\":53,\"k\":4,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"Telephone endpoint is 564-200-3685.\",\"y\":[]},{\"b\":[],\"d\":[53],\"e\":[\"s35\"],\"i\":54,\"k\":5,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"Telephone endpoint is supplied for Ash Noble, responsible for drafting.\",\"y\":[]},{\"b\":[],\"d\":[8],\"e\":[\"s35\"],\"i\":55,\"k\":0,\"m\":0,\"p\":0,\"q\":0,\"r\":\"\",\"s\":\"Ash Noble is the agency personnel responsible for drafting.\",\"y\":[]}],\"v\":\"r16.w1\",\"z\":\"END\"}","refusal":null,"reasoning":null,"reasoning_details":[{"type":"reasoning.encrypted","data":"gAAAAABqz8O4xII34xYZkyvQNykG0EJVYqzqBLD-aj1sI1prHvljsCYqNPlSrbhDU_Wm22i3cbxDssDJK13L-Z0FRpkp7Up8j-02D-xhZamjTvdPOPGJNtmRFVDbfzYd9xoouwBIWfa1TsM7yVeNN-QahO0Ppopz9Yko1JBHIxo1VHrnhRAhzaBdeV1nh_14KOdg1DNkprQNWRq-sGvYTgO4Xe-omteGegn8oglQK17aLKVZBVC7j8afzNGWNwos7lzcQyhxth1NKEB1YIzTI1gbxEhQtlcgZN5p8VL3gi6LDuWxqu_OJ8ayNMLDmumR4lLGRnilhh4WeRmFOVZz2oVRR_I5ZFwxZWxmJLAdOplSiOiHS