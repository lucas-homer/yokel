    "document_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "completeness": {
      "type": "object",
      "properties": {
