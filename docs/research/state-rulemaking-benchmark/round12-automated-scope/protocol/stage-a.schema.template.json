{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "round12.source-inventory.v1"
      ]
    },
    "source_text_sha256": {
      "type": "string",
      "enum": [
        "__SOURCE_SHA256__"
      ]
    },
    "units": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/u"
      },
      "minItems": 1,
      "maxItems": 64
    }
  },
  "required": [
    "schema_version",
    "source_text_sha256",
    "units"
  ],
  "additionalProperties": false,
  "$defs": {
    "e": {
      "type": "object",
      "properties": {
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320
        },
        "occurrence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      },
      "required": [
        "quote",
        "occurrence"
      ],
      "additionalProperties": false
    },
    "u": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "kind": {
          "type": "string",
          "enum": [
            "identity",
            "rule_transition",
            "phase",
            "timing",
            "endpoint",
            "endpoint_role",
            "instruction",
            "relationship",
            "background"
          ]
        },
        "assertion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 360
        },
        "modality": {
          "type": "string",
          "enum": [
            "mandatory",
            "advisory",
            "optional",
            "informational",
            "prohibited",
            "unknown",
            "not_applicable"
          ]
        },
        "applicability": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "uncertainty": {
          "type": "string",
          "enum": [
            "none",
            "source_ambiguous",
            "reference_unresolved"
          ]
        },
        "uncertainty_reason": {
          "type": "string",
          "maxLength": 240
        },
        "required_unit_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16
          },
          "minItems": 0,
          "maxItems": 16
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/e"
          },
          "minItems": 1,
          "maxItems": 3
        }
      },
      "required": [
        "id",
        "kind",
        "assertion",
        "modality",
        "applicability",
        "uncertainty",
        "uncertainty_reason",
        "required_unit_ids",
        "evidence"
      ],
      "additionalProperties": false
    }
  }
}
